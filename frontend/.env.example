# Arogya AI — Frontend Environment Variables Template
# Module 4, Phase 4.1: Initialize Next.js Frontend with TypeScript.
#
# Copy this template to .env.local for local overrides.
# Never commit .env.local or sensitive credentials to version control.

# Base URL for backend FastAPI service endpoints (Module 2/3)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Target application environment profile ('development', 'testing', 'staging', 'production')
NEXT_PUBLIC_APP_ENV=development
