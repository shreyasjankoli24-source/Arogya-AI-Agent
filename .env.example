# ==============================================================================
# Arogya AI — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local development setup.
# NOTE: Never commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings (Module 2 Backend)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Arogya AI
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# Backend API Server (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# API Documentation & Schema Discovery
# Defaults: /openapi.json, /docs, /redoc
# To disable in staging or production environments, set to 'none', 'disabled',
# or leave the value empty (e.g. DOCS_URL=none).
# IMPORTANT: Disabling documentation reduces surface visibility, but is NOT a
# substitute for network firewalls, authentication, or role-based access control.
# ------------------------------------------------------------------------------
OPENAPI_URL=/openapi.json
DOCS_URL=/docs
REDOC_URL=/redoc

# ------------------------------------------------------------------------------
# Frontend Application (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Persistence (PostgreSQL / SQLAlchemy — Module 3)
# Leave empty (DATABASE_URL=) for local unit testing without database dependency.
# For local development with PostgreSQL, specify your local connection URL:
# Standard Psycopg 3 format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Example placeholder: postgresql+psycopg://postgres:postgres@localhost:5432/arogya_ai
# IMPORTANT: Never commit actual passwords or connection strings to Git.
# Ensure .env is listed in .gitignore and keep credentials outside version control.
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# Security, Identity & File Handling (Module 7)
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 32+ character secret for production JWT signing.
# Example: openssl rand -hex 32
SECRET_KEY=arogya-ai-insecure-dev-secret-key-change-in-production-min-32-chars-long

# JWT token expiration time in minutes (default 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure local storage directory for uploaded clinical assets (outside web root)
UPLOAD_STORAGE_DIR=storage/uploads

# Maximum allowed file upload size in bytes (default 20971520 = 20MB)
MAX_UPLOAD_SIZE_BYTES=20971520

# Initial administrator bootstrap credentials (used by scripts/bootstrap_admin.py)
# Never commit real passwords to version control
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@arogya.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# ------------------------------------------------------------------------------
# AI & LLM Inference Providers (Planned in Modules 11–12)
# Optional placeholders. Features are not yet implemented.
# Leave empty unless actively evaluating in research modules.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_PROVIDER=
